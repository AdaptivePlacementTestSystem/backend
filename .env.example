# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placement_test_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=7200

# Rate-limit đăng nhập / quên mật khẩu (DECISIONS_LOG #134, D3)
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_TTL_SECONDS=60
RATE_LIMIT_FORGOT_LIMIT=3
RATE_LIMIT_FORGOT_TTL_SECONDS=3600
RATE_LIMIT_RESET_LIMIT=20
RATE_LIMIT_RESET_TTL_SECONDS=60
# Chỉ đếm đăng nhập THẤT BẠI theo IP (không chặn nhầm phòng thi dùng chung IP)
RATE_LIMIT_LOGIN_IP_FAILURE_LIMIT=100
RATE_LIMIT_LOGIN_IP_FAILURE_TTL_SECONDS=600

# Số tầng reverse proxy tin cậy để lấy đúng IP client (Nginx = 1; 0 = không tin proxy)
TRUST_PROXY_HOPS=1

# JWT
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CAT Engine params (SRS Muc 4.2-4.5)
CAT_THETA_INIT=-0.5
CAT_PRIOR_MEAN=0.0
CAT_PRIOR_VARIANCE=1.0
CAT_QUADRATURE_POINTS=41
CAT_MAX_ITEMS=25
CAT_SE_THRESHOLD=0.35
# CAT Outlier Early Stop (ngưỡng θ sau >= 8 câu, SRS Mục 4.5)
CAT_OUTLIER_THETA_MIN=-2.5
CAT_OUTLIER_THETA_MAX=1.5
CAT_OUTLIER_MIN_ITEMS=8
# CAT Item Bank Valid Difficulty Range (DC-34)
CAT_ITEM_B_MIN=-4.0
CAT_ITEM_B_MAX=4.0
CAT_TOP_N_ITEMS=5

# AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# M2M (EduZ API Key)
EDUZ_API_KEY=your_eduz_m2m_api_key

# Seed Passwords (bat buoc cho prisma db seed)
# Admin gốc (npm run db:seed:admin): email đăng nhập + họ tên; mật khẩu ban đầu lấy từ SEED_ADMIN_PASSWORD
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_FULL_NAME="Quản trị viên hệ thống"
SEED_ADMIN_PASSWORD=your_seed_admin_password
SEED_TEACHER_PASSWORD=your_seed_teacher_password
SEED_STUDENT_PASSWORD=your_seed_student_password

# App
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1


# Mail / SMTP (MailPort)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Adaptive Placement Test <your_email@gmail.com>"

# Import tài khoản bằng file .xlsx (đều có giá trị mặc định; chỉ đặt khi cần đổi)
# IMPORT_MAX_FILE_BYTES=2097152
# IMPORT_MAX_ROWS=1000
# IMPORT_GRID_TTL_SECONDS=1800
# IMPORT_JOB_TTL_SECONDS=3600
# IMPORT_HASH_CONCURRENCY=4
# Hàng đợi gửi email trong tiến trình
# MAIL_QUEUE_CONCURRENCY=3
# MAIL_QUEUE_MAX_ATTEMPTS=3
# MAIL_QUEUE_BACKOFF_MS=1000
