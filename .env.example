# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placement_test_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=7200

# JWT
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CAT Engine params (SRS Muc 4.2-4.5)
CAT_THETA_INIT=-0.5
CAT_PRIOR_MEAN=0.0
CAT_PRIOR_VARIANCE=1.0
CAT_QUADRATURE_POINTS=41
CAT_MAX_ITEMS=25
CAT_SE_THRESHOLD=0.35
# CAT Outlier Early Stop (ngưỡng θ sau >= 8 câu, SRS Mục 4.5)
CAT_OUTLIER_THETA_MIN=-2.5
CAT_OUTLIER_THETA_MAX=1.5
CAT_OUTLIER_MIN_ITEMS=8
# CAT Item Bank Valid Difficulty Range (DC-34)
CAT_ITEM_B_MIN=-4.0
CAT_ITEM_B_MAX=4.0
CAT_TOP_N_ITEMS=5

# AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# M2M (EduZ API Key)
EDUZ_API_KEY=your_eduz_m2m_api_key

# Seed Passwords (bat buoc cho prisma db seed)
SEED_ADMIN_PASSWORD=your_seed_admin_password
SEED_TEACHER_PASSWORD=your_seed_teacher_password
SEED_STUDENT_PASSWORD=your_seed_student_password

# App
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
